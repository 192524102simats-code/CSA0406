5th question 
File Allocation + Disk Scheduling
#include <stdio.h>
#include <stdlib.h>
int main()
{
 int n, size, choice, schedule;
 int block[50], i, head, total = 0;
 printf("Enter disk size: ");
 scanf("%d", &n);
 printf("Enter file size: ");
 scanf("%d", &size);
 printf("1. Contiguous\n2. Indexed\n");
 printf("Enter allocation choice: ");
 scanf("%d", &choice);
 printf("Allocated blocks: ");
 if (choice == 1)
 {
 for (i = 0; i < size; i++)
 {
 block[i] = i;
 printf("%d ", block[i]);
 }
 }
 else
 {
 printf("\nIndex block = 0\n");
printf("Data blocks: ");
 for (i = 0; i < size; i++)
 {
 block[i] = i + 1;
 printf("%d ", block[i]);
 }
 }
 printf("\n1. FCFS\n2. SSTF\n");
 printf("Enter scheduling choice: ");
 scanf("%d", &schedule);
 printf("Enter head position: ");
 scanf("%d", &head);
 printf("Seek sequence: %d ", head);
 /* Simple FCFS scheduling */
 for (i = 0; i < size; i++)
 {
 total += abs(head - block[i]);
 head = block[i];
 printf("-> %d ", head);
 }
 printf("\nTotal seek time = %d", total);
 return 0;
}
