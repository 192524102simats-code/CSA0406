#include <stdio.h>
#include <stdlib.h>

struct Record
{
    int id;
    char name[50];
};

int main()
{
    struct Record records[50];
    int n, i, search_id, found = 0;

    printf("Enter number of records: ");
    scanf("%d", &n);

    // Store records sequentially
    printf("\nEnter record details:\n");

    for (i = 0; i < n; i++)
    {
        printf("\nRecord %d\n", i + 1);

        printf("Enter ID: ");
        scanf("%d", &records[i].id);

        printf("Enter Name: ");
        scanf("%s", records[i].name);
    }

    // Display records in sequential order
    printf("\nRecords stored sequentially:\n");
    printf("--------------------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("Record %d: ID = %d, Name = %s\n",
               i + 1, records[i].id, records[i].name);
    }

    // Search for a particular record
    printf("\nEnter ID of the record to access: ");
    scanf("%d", &search_id);

    printf("\nReading records sequentially...\n");

    for (i = 0; i < n; i++)
    {
        printf("Reading Record %d: ID = %d, Name = %s\n",
               i + 1, records[i].id, records[i].name);

        if (records[i].id == search_id)
        {
            printf("\nRecord found!\n");
            printf("ID   : %d\n", records[i].id);
            printf("Name : %s\n", records[i].name);

            found = 1;
            break;
        }
    }

    if (!found)
        printf("\nRecord not found.\n");

    return 0;
}
