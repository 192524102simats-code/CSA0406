#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int bt[20], rt[20], at[20], pr[20];
    int wt[20], tat[20], ct[20];
    float avg_wt = 0, avg_tat = 0;

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    // Input process details
    for(i = 0; i < n; i++) {
        printf("\nProcess P%d\n", i + 1);

        printf("Arrival Time: ");
        scanf("%d", &at[i]);

        printf("Burst Time: ");
        scanf("%d", &bt[i]);

        printf("Priority (Smaller number = Higher priority): ");
        scanf("%d", &pr[i]);

        rt[i] = bt[i];   // Remaining time
    }

    while(completed != n) {
        int highest = -1;

        // Find highest priority process among arrived processes
        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0) {
                if(highest == -1 || pr[i] < pr[highest])
                    highest = i;
            }
        }

        if(highest == -1) {
            time++;
            continue;
        }

        // Execute for one unit of time
        rt[highest]--;
        time++;

        // Process completed
        if(rt[highest] == 0) {
            completed++;
            ct[highest] = time;
            tat[highest] = ct[highest] - at[highest];
            wt[highest] = tat[highest] - bt[highest];

            avg_wt += wt[highest];
            avg_tat += tat[highest];
        }
    }

    // Display results
    printf("\nProcess\tAT\tBT\tPR\tCT\tTAT\tWT\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i],
               ct[i], tat[i], wt[i]);
    }

    printf("\nAverage Waiting Time = %.2f", avg_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}
