#include <stdio.h>
#include <pthread.h>
#include <unistd.h>
#define N 5
pthread_t philosopher[N];
pthread_mutex_t fork[N];
void *philosopher_function(void *arg)
{
    int id = *(int *)arg;
    int left = id;
    int right = (id + 1) % N;

    printf("Philosopher %d is thinking...\n", id + 1);
    sleep(1);
    pthread_mutex_lock(&fork[left]);
    printf("Philosopher %d picked up left fork.\n", id 
    pthread_mutex_lock(&fork[right]);
    printf("Philosopher %d picked up right fork.\n", id + 1);
    printf("Philosopher %d is eating.\n", id + 1);
    sleep(2);
    pthread_mutex_unlock(&fork[right]);
    pthread_mutex_unlock(&fork[left]);
    printf("Philosopher %d finished eating and put down forks.\n", id + 1);
    return NULL;
}
int main()
{
    int id[N];
    for (int i = 0; i < N; i++)
        pthread_mutex_init(&fork[i], NULL);
    for (int i = 0; i < N; i++)
    {
        id[i] = i;
        pthread_create(&philosopher[i], NULL,
                       philosopher_function, &id[i]);
    }
    for (int i = 0; i < N; i++)
        pthread_join(philosopher[i], NULL);
    for (int i = 0; i < N; i++)
        pthread_mutex_destroy(&fork[i]);
    printf("\nAll philosophers have finished eating.\n");
    return 0;
}
