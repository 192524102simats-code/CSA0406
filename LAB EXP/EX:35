#include <stdio.h>

int main()
{
    int indexBlock[50];
    int n, i, block;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    // Read block numbers
    printf("\nEnter the block numbers of the file:\n");

    for (i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &indexBlock[i]);
    }

    // Display index block
    printf("\nINDEX BLOCK\n");
    printf("-------------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("Index %d -> Block %d\n",
               i, indexBlock[i]);
    }

    // Access a particular block
    printf("\nEnter the block position to access (1-%d): ", n);
    scanf("%d", &block);

    if (block >= 1 && block <= n)
    {
        printf("\nIndex block entry %d points to file block %d.\n",
               block, indexBlock[block - 1]);

        printf("File block %d is accessed successfully.\n",
               indexBlock[block - 1]);
    }
    else
    {
        printf("Invalid block position.\n");
    }

    return 0;
}
