#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/types.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int shmid;
    char *shared_memory;

    // Create shared memory segment
    shmid = shmget(IPC_PRIVATE, 1024, 0666 | IPC_CREAT);
    if (shmid < 0) {
        printf("Shared memory creation failed.\n");
        return 1;
    }

    pid_t pid = fork();

    if (pid == 0) {
        // Child Process
        sleep(1);

        shared_memory = (char *)shmat(shmid, NULL, 0);

        printf("Child Process Read: %s\n", shared_memory);

        shmdt(shared_memory);
    }
    else {
        // Parent Process
        shared_memory = (char *)shmat(shmid, NULL, 0);

        strcpy(shared_memory, "Hello from Parent Process!");

        printf("Parent Process Wrote: %s\n", shared_memory);

        wait(NULL);

        shmdt(shared_memory);
        shmctl(shmid, IPC_RMID, NULL);   // Remove shared memory
    }

    return 0;
}
