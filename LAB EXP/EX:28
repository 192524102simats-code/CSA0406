#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[100];
    char pattern[100];
    char line[500];

    printf("Enter the file name: ");
    scanf("%s", filename);

    printf("Enter the pattern to search: ");
    scanf("%s", pattern);

    // Open the file
    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        printf("Unable to open file.\n");
        return 1;
    }

    printf("\nLines containing \"%s\":\n", pattern);

    // Read file line by line
    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (strstr(line, pattern) != NULL)
        {
            printf("%s", line);
        }
    }

    // Close the file
    fclose(fp);

    return 0;
}
