#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char buffer[100];
    char data[100];

    /* Create and open the file */
    fd = open("file.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    printf("File created and opened successfully.\n");

    /* Write operation */
    strcpy(data, "Welcome to UNIX File Management.\n");

    if (write(fd, data, strlen(data)) < 0)
    {
        perror("Write failed");
        close(fd);
        return 1;
    }

    printf("Data written successfully.\n");

    /* Move file pointer to beginning */
    lseek(fd, 0, SEEK_SET);

    /* Read operation */
    int n = read(fd, buffer, sizeof(buffer) - 1);

    if (n < 0)
    {
        perror("Read failed");
        close(fd);
        return 1;
    }

    buffer[n] = '\0';

    printf("\nFile contents:\n");
    printf("%s", buffer);

    /* Append operation */
    lseek(fd, 0, SEEK_END);

    strcpy(data, "File management operations are completed.\n");

    write(fd, data, strlen(data));

    printf("\nData appended successfully.\n");

    /* Close operation */
    close(fd);

    printf("File closed successfully.\n");

    return 0;
}
